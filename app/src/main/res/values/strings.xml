    <string name="setup_permission_title">Allow pausing work apps</string>
    <string name="setup_permission_why">Android only lets this app pause the work profile after a one-time grant from a computer. Connect with USB debugging and run:</string>
    <string name="setup_permission_verify">Then reopen this app. This step disappears once the grant worked.</string>

    <string name="setup_no_profile_title">No work profile found</string>
    <string name="setup_no_profile_why">Install this app in your personal profile (not inside the work profile), and make sure the work profile is fully set up.</string>
    <string name="setup_scan_again">Scan again</string>
    <string name="setup_choose_title">Choose your work profile</string>
    <string name="setup_choose_why">More than one work profile was found (Secure Folder and similar features can look like one). Pick the one your employer manages.</string>
    <string name="setup_identify_title">Identify your work profile</string>
    <string name="setup_identify_why">Android did not say which profile is the work profile. With this screen open, turn \"Work apps\" off and on once in Quick Settings, and it will be detected.</string>
    <string name="setup_identify_manual">Or choose it yourself:</string>
    <string name="profile_row_detail">User serial %1$d · %2$s</string>
