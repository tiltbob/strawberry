    <string name="profile_confirm_title">Use this profile?</string>
    <string name="profile_confirm_text">Android could not confirm that \"%1$s\" is a work profile. If it is something else, such as cloned apps or a private space, the schedule will pause that instead.</string>
    <string name="profile_confirm_ok">Use it</string>
    <string name="profile_choose_title">Choose the work profile</string>
    <string name="cancel">Cancel</string>

    <string name="setup_notifications_title">Allow notifications</string>
    <string name="setup_notifications_why">So the app can tell you when work apps need your PIN or when something went wrong.</string>
    <string name="setup_exact_title">Allow alarms and reminders</string>
    <string name="setup_exact_why">Without exact alarms, work apps can pause or turn on up to an hour late.</string>
    <string name="setup_unused_title">Keep the app active</string>
    <string name="setup_unused_why">Android pauses apps that are not opened for a few months, which cancels the schedule. Turn off \"Pause app activity if unused\".</string>
    <string name="setup_battery_title">Unrestricted battery use</string>
    <string name="setup_battery_why">Some phones delay or drop alarms to save battery. Allowing unrestricted use makes the schedule reliable. From a computer you can also run:</string>

